# MicroPython device state - never commit live settings/memory/secrets
# /opt/data is the device data home (sessions, activity, memory, skills,
# workspace, cron, tokens) - ignore the whole tree, not just sessions.
opt/
config.yaml
config.yaml.tmp
config.json
config.json.bak
config.json.tmp
memory.txt
user.txt
chatlog.jsonl
chatlog*.jsonl
activity.jsonl
activity.prev.jsonl
opt/data/sessions/
cron.json
bundles.json
pending_mem.json
pending_skills/
tg.json
*.tmp
*.bak

# CPython test / editor artifacts
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.playwright-mcp/
*.pyc
*.pyo
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
.env
.env.*

# Front-end toolchain (ui/ is source; www/ is the committed build output)
node_modules/
ui/dist/
*.tsbuildinfo
npm-debug.log*
